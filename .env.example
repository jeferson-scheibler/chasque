# Copie para .env e troque os valores. O .env nunca vai para o git.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Origens do front que podem chamar a API (web e Capacitor).
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,capacitor://localhost,https://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

POSTGRES_DB=chasque
POSTGRES_USER=chasque
POSTGRES_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432

# UID/GID do usuario da VM, para os arquivos gerados no container (migrations) ficarem com o dono certo.
APP_UID=1001
APP_GID=1001
