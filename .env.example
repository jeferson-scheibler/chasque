# Copie para .env e troque os valores. O .env nunca vai para o git.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# 0 sempre que o app estiver acessível de fora da VM (sem páginas de erro detalhadas, cookie só em HTTPS).
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,chasque.177-44-248-30.sslip.io
# Origens do front que podem chamar a API (web e Capacitor).
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,https://chasque.177-44-248-30.sslip.io,capacitor://localhost,https://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,https://chasque.177-44-248-30.sslip.io

# Endereço público (nginx da VM -> app). O Vite só responde a hosts listados aqui.
APP_HOSTS=chasque.177-44-248-30.sslip.io
# Proxies entre o celular e o Django (nginx). O limite de tentativas usa o IP real.
DRF_NUM_PROXIES=1

POSTGRES_DB=chasque
POSTGRES_USER=chasque
POSTGRES_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432

# UID/GID do usuario da VM, para os arquivos gerados no container (migrations) ficarem com o dono certo.
APP_UID=1001
APP_GID=1001

# Web Push (avisos de roteiro de fim de semana). Gere com: docker exec chasque-api-1 python manage.py gerar_chaves_push
# Sem as chaves, o roteiro aparece só dentro do app.
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTATO=mailto:contato@chasque.app
